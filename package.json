{
  "name": "dsh-secure-gate",
  "version": "1.0.0",
  "description": "🛡️ 高级安全认证网关 for DeepSeek Harness — Argon2id 密码、CSRF 保护、账户锁定、IP 访问控制、审计日志、会话管理、TOTP 两步验证、WebAuthn/Passkey 预备。零配置启动，即装即用。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auth",
    "authentication",
    "security",
    "mfa",
    "totp",
    "2fa",
    "csrf",
    "argon2",
    "passkey",
    "webauthn",
    "login"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "docs",
    "assets"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "",
  "bugs": ""
}
